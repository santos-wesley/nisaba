"{\"activities\":[{\"name\":\"Identify Risks\",\"description\":\"The 'Identify Risks' activity represents the initial phase of pinpointing potential threats and vulnerabilities in the business continuity management process.\"},{\"name\":\"Develop Continuity Plan\",\"description\":\"The 'Develop Continuity Plan' activity involves creating a comprehensive strategy to ensure business operations can continue during disruptions.\"},{\"name\":\"Test Continuity Plan\",\"description\":\"The 'Test Continuity Plan' activity includes simulating scenarios to evaluate the effectiveness of the continuity plan.\"},{\"name\":\"Review Test Results\",\"description\":\"The 'Review Test Results' activity focuses on analyzing outcomes from continuity plan tests to identify strengths and weaknesses.\"},{\"name\":\"Implement Improvements\",\"description\":\"The 'Implement Improvements' activity entails applying changes and enhancements based on test reviews to strengthen the continuity plan.\"},{\"name\":\"Communicate Plan\",\"description\":\"The 'Communicate Plan' activity is responsible for disseminating the continuity plan details to relevant stakeholders using appropriate methods.\"},{\"name\":\"Monitor Risks\",\"description\":\"The 'Monitor Risks' activity involves ongoing surveillance of identified risks to detect any changes or emerging threats.\"},{\"name\":\"Conduct Training\",\"description\":\"The 'Conduct Training' activity includes educating staff on the continuity plan and their roles during an incident.\"},{\"name\":\"Activate Continuity Plan\",\"description\":\"The 'Activate Continuity Plan' activity triggers the execution of the continuity plan in response to an actual incident.\"},{\"name\":\"Evaluate Incident Response\",\"description\":\"The 'Evaluate Incident Response' activity assesses the performance and outcomes of the activated continuity plan after an incident.\"}],\"attributes\":[{\"type\":\"integer\",\"name\":\"Risk Level\",\"description\":\"The attribute 'Risk Level: integer between 1 and 10' quantifies the severity or priority of identified risks on a scale from 1 to 10.\",\"min_value\":1,\"max_value\":10,\"enumeration_values\":null},{\"type\":\"float\",\"name\":\"Plan Effectiveness\",\"description\":\"The attribute 'Plan Effectiveness: float between 0.0 and 100.0' measures the performance of the continuity plan as a percentage value ranging from 0.0 to 100.0.\",\"min_value\":0.0,\"max_value\":100.0,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Test Outcome\",\"description\":\"The attribute 'Test Outcome: Pass, Fail' indicates whether the continuity plan test was successful (Pass) or unsuccessful (Fail).\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Pass\",\"Fail\"]},{\"type\":\"enumeration\",\"name\":\"Improvement Status\",\"description\":\"The attribute 'Improvement Status: Completed, Pending' tracks the progress of implemented improvements as either Completed or Pending.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Completed\",\"Pending\"]},{\"type\":\"enumeration\",\"name\":\"Communication Method\",\"description\":\"The attribute 'Communication Method: Email, Meeting, Newsletter' specifies the channel used to communicate the continuity plan, which can be Email, Meeting, or Newsletter.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Email\",\"Meeting\",\"Newsletter\"]},{\"type\":\"integer\",\"name\":\"Training Hours\",\"description\":\"The attribute 'Training Hours: integer between 1 and 40' represents the duration of training sessions in hours, ranging from 1 to 40.\",\"min_value\":1,\"max_value\":40,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Incident Severity\",\"description\":\"The attribute 'Incident Severity: Low, Medium, High' categorizes the seriousness of an incident as Low, Medium, or High.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Low\",\"Medium\",\"High\"]},{\"type\":\"float\",\"name\":\"Response Time\",\"description\":\"The attribute 'Response Time: float between 0.0 and 24.0' measures the time taken to respond to an incident in hours, with values from 0.0 to 24.0.\",\"min_value\":0.0,\"max_value\":24.0,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Stakeholder Engagement\",\"description\":\"The attribute 'Stakeholder Engagement: High, Moderate, Low' assesses the level of involvement from stakeholders as High, Moderate, or Low.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"High\",\"Moderate\",\"Low\"]},{\"type\":\"integer\",\"name\":\"Monitoring Frequency\",\"description\":\"The attribute 'Monitoring Frequency: integer between 1 and 30' indicates how often risks are monitored, in days or units, ranging from 1 to 30.\",\"min_value\":1,\"max_value\":30,\"enumeration_values\":null}],\"binds\":[{\"activity\":{\"name\":\"Identify Risks\",\"description\":\"The 'Identify Risks' activity represents the initial phase of pinpointing potential threats and vulnerabilities in the business continuity management process.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Risk Level\",\"description\":\"The attribute 'Risk Level: integer between 1 and 10' quantifies the severity or priority of identified risks on a scale from 1 to 10.\",\"min_value\":1,\"max_value\":10,\"enumeration_values\":null}],\"description\":\"The bind 'Identify Risks: Risk Level' specifies that the activity 'Identify Risks' requires the attribute 'Risk Level'.\"},{\"activity\":{\"name\":\"Test Continuity Plan\",\"description\":\"The 'Test Continuity Plan' activity includes simulating scenarios to evaluate the effectiveness of the continuity plan.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Test Outcome\",\"description\":\"The attribute 'Test Outcome: Pass, Fail' indicates whether the continuity plan test was successful (Pass) or unsuccessful (Fail).\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Pass\",\"Fail\"]}],\"description\":\"The bind 'Test Continuity Plan: Test Outcome' links the 'Test Continuity Plan' activity with the attribute 'Test Outcome'.\"},{\"activity\":{\"name\":\"Review Test Results\",\"description\":\"The 'Review Test Results' activity focuses on analyzing outcomes from continuity plan tests to identify strengths and weaknesses.\"},\"attributes\":[{\"type\":\"float\",\"name\":\"Plan Effectiveness\",\"description\":\"The attribute 'Plan Effectiveness: float between 0.0 and 100.0' measures the performance of the continuity plan as a percentage value ranging from 0.0 to 100.0.\",\"min_value\":0.0,\"max_value\":100.0,\"enumeration_values\":null}],\"description\":\"The bind 'Review Test Results: Plan Effectiveness' associates the 'Review Test Results' activity with the attribute 'Plan Effectiveness'.\"},{\"activity\":{\"name\":\"Implement Improvements\",\"description\":\"The 'Implement Improvements' activity entails applying changes and enhancements based on test reviews to strengthen the continuity plan.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Improvement Status\",\"description\":\"The attribute 'Improvement Status: Completed, Pending' tracks the progress of implemented improvements as either Completed or Pending.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Completed\",\"Pending\"]}],\"description\":\"The bind 'Implement Improvements: Improvement Status' connects the 'Implement Improvements' activity to the attribute 'Improvement Status'.\"},{\"activity\":{\"name\":\"Communicate Plan\",\"description\":\"The 'Communicate Plan' activity is responsible for disseminating the continuity plan details to relevant stakeholders using appropriate methods.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Communication Method\",\"description\":\"The attribute 'Communication Method: Email, Meeting, Newsletter' specifies the channel used to communicate the continuity plan, which can be Email, Meeting, or Newsletter.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Email\",\"Meeting\",\"Newsletter\"]}],\"description\":\"The bind 'Communicate Plan: Communication Method' ties the 'Communicate Plan' activity to the attribute 'Communication Method'.\"},{\"activity\":{\"name\":\"Conduct Training\",\"description\":\"The 'Conduct Training' activity includes educating staff on the continuity plan and their roles during an incident.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Training Hours\",\"description\":\"The attribute 'Training Hours: integer between 1 and 40' represents the duration of training sessions in hours, ranging from 1 to 40.\",\"min_value\":1,\"max_value\":40,\"enumeration_values\":null}],\"description\":\"The bind 'Conduct Training: Training Hours' links the 'Conduct Training' activity with the attribute 'Training Hours'.\"},{\"activity\":{\"name\":\"Activate Continuity Plan\",\"description\":\"The 'Activate Continuity Plan' activity triggers the execution of the continuity plan in response to an actual incident.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Incident Severity\",\"description\":\"The attribute 'Incident Severity: Low, Medium, High' categorizes the seriousness of an incident as Low, Medium, or High.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Low\",\"Medium\",\"High\"]}],\"description\":\"The bind 'Activate Continuity Plan: Incident Severity' specifies that the activity 'Activate Continuity Plan' uses the attribute 'Incident Severity'.\"},{\"activity\":{\"name\":\"Evaluate Incident Response\",\"description\":\"The 'Evaluate Incident Response' activity assesses the performance and outcomes of the activated continuity plan after an incident.\"},\"attributes\":[{\"type\":\"float\",\"name\":\"Response Time\",\"description\":\"The attribute 'Response Time: float between 0.0 and 24.0' measures the time taken to respond to an incident in hours, with values from 0.0 to 24.0.\",\"min_value\":0.0,\"max_value\":24.0,\"enumeration_values\":null}],\"description\":\"The bind 'Evaluate Incident Response: Response Time' associates the 'Evaluate Incident Response' activity with the attribute 'Response Time'.\"},{\"activity\":{\"name\":\"Monitor Risks\",\"description\":\"The 'Monitor Risks' activity involves ongoing surveillance of identified risks to detect any changes or emerging threats.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Monitoring Frequency\",\"description\":\"The attribute 'Monitoring Frequency: integer between 1 and 30' indicates how often risks are monitored, in days or units, ranging from 1 to 30.\",\"min_value\":1,\"max_value\":30,\"enumeration_values\":null}],\"description\":\"The bind 'Monitor Risks: Monitoring Frequency' connects the 'Monitor Risks' activity to the attribute 'Monitoring Frequency'.\"},{\"activity\":{\"name\":\"Develop Continuity Plan\",\"description\":\"The 'Develop Continuity Plan' activity involves creating a comprehensive strategy to ensure business operations can continue during disruptions.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Stakeholder Engagement\",\"description\":\"The attribute 'Stakeholder Engagement: High, Moderate, Low' assesses the level of involvement from stakeholders as High, Moderate, or Low.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"High\",\"Moderate\",\"Low\"]}],\"description\":\"The bind 'Develop Continuity Plan: Stakeholder Engagement' links the 'Develop Continuity Plan' activity with the attribute 'Stakeholder Engagement'.\"}],\"constraints\":[{\"type\":\"unary\",\"description\":\"The 'Identify Risks' must be the first activity to occur in the process.\",\"template\":\"Init\",\"activation\":{\"name\":\"Identify Risks\",\"description\":\"The 'Identify Risks' activity represents the initial phase of pinpointing potential threats and vulnerabilities in the business continuity management process.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"unary\",\"description\":\"The 'Evaluate Incident Response' must be the last activity to occur in the process.\",\"template\":\"End\",\"activation\":{\"name\":\"Evaluate Incident Response\",\"description\":\"The 'Evaluate Incident Response' activity assesses the performance and outcomes of the activated continuity plan after an incident.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Test Continuity Plan' activity occurs with the condition that A.Test Outcome is Pass, then a 'Review Test Results' activity must occur after that 'Test Continuity Plan' event and before any subsequent 'Test Continuity Plan' occurs; no other occurrence of 'Test Continuity Plan' is allowed between a 'Test Continuity Plan' and its corresponding 'Review Test Results'. This must happen within a time frame of 0 to 2 days.\",\"template\":\"Alternate Response\",\"activation\":{\"name\":\"Test Continuity Plan\",\"description\":\"The 'Test Continuity Plan' activity includes simulating scenarios to evaluate the effectiveness of the continuity plan.\"},\"target\":{\"name\":\"Review Test Results\",\"description\":\"The 'Review Test Results' activity focuses on analyzing outcomes from continuity plan tests to identify strengths and weaknesses.\"},\"activation_condition\":\"A.Test Outcome is Pass\",\"correlation_condition\":null,\"time_condition\":\"0,2,d\",\"cardinality\":null},{\"type\":\"binary\",\"description\":\"Whenever a 'Review Test Results' activity occurs with the condition that A.Plan Effectiveness < 80.0, it must be immediately followed by an 'Implement Improvements' activity in the next event position, with no other events in between, where the correlation condition is A.Improvement Status is Pending. This must occur within a time frame of 0 to 48 hours. The 'Implement Improvements' activity is allowed to happen isolated.\",\"template\":\"Chain Response\",\"activation\":{\"name\":\"Review Test Results\",\"description\":\"The 'Review Test Results' activity focuses on analyzing outcomes from continuity plan tests to identify strengths and weaknesses.\"},\"target\":{\"name\":\"Implement Improvements\",\"description\":\"The 'Implement Improvements' activity entails applying changes and enhancements based on test reviews to strengthen the continuity plan.\"},\"activation_condition\":\"A.Plan Effectiveness < 80.0\",\"correlation_condition\":\"A.Improvement Status is Pending\",\"time_condition\":\"0,48,h\",\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Develop Continuity Plan' activity occurs with the condition that A.Stakeholder Engagement is High, then a 'Communicate Plan' activity must eventually occur after the 'Develop Continuity Plan' event at some point in the same process instance, where the correlation condition is A.Communication Method in (Email, Meeting). There is no requirement on how soon or what events may occur in between, but it must happen within a time frame of 5 to 13 minutes. Multiple 'Develop Continuity Plan' can be pending at the same time, and a single 'Communicate Plan' can fulfill the obligation for all preceding 'Develop Continuity Plan'. If 'Develop Continuity Plan' does not occur, the constraint imposes no obligation on the occurrence of 'Communicate Plan'.\",\"template\":\"Response\",\"activation\":{\"name\":\"Develop Continuity Plan\",\"description\":\"The 'Develop Continuity Plan' activity involves creating a comprehensive strategy to ensure business operations can continue during disruptions.\"},\"target\":{\"name\":\"Communicate Plan\",\"description\":\"The 'Communicate Plan' activity is responsible for disseminating the continuity plan details to relevant stakeholders using appropriate methods.\"},\"activation_condition\":\"A.Stakeholder Engagement is High\",\"correlation_condition\":\"A.Communication Method in (Email, Meeting)\",\"time_condition\":\"5,13,m\",\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If 'Communicate Plan' activity occurs with the condition that A.Communication Method is Meeting in a process instance, then 'Conduct Training' activity must also occur at least once within the same process instance, either before or after the 'Communicate Plan' event. If 'Communicate Plan' does not occur, there is no requirement for 'Conduct Training' to occur. Multiple occurrences of 'Communicate Plan' are satisfied by at least one occurrence of 'Conduct Training', and multiple 'Conduct Training' instances are allowed.\",\"template\":\"Responded Existence\",\"activation\":{\"name\":\"Communicate Plan\",\"description\":\"The 'Communicate Plan' activity is responsible for disseminating the continuity plan details to relevant stakeholders using appropriate methods.\"},\"target\":{\"name\":\"Conduct Training\",\"description\":\"The 'Conduct Training' activity includes educating staff on the continuity plan and their roles during an incident.\"},\"activation_condition\":\"A.Communication Method is Meeting\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Identify Risks' activity is permitted to occur only if an 'Activate Continuity Plan' activity has occurred before it within the same process instance, where the activation condition is A.Incident Severity in (Medium, High). Activations that occur without any prior 'Activate Continuity Plan' are violations of the constraint. Multiple 'Activate Continuity Plan' can occur, and any number of events (including other 'Identify Risks') can happen between an 'Activate Continuity Plan' and a subsequent 'Identify Risks'. This ensures that certain actions cannot proceed without the necessary prerequisites being met first.\",\"template\":\"Precedence\",\"activation\":{\"name\":\"Identify Risks\",\"description\":\"The 'Identify Risks' activity represents the initial phase of pinpointing potential threats and vulnerabilities in the business continuity management process.\"},\"target\":{\"name\":\"Activate Continuity Plan\",\"description\":\"The 'Activate Continuity Plan' activity triggers the execution of the continuity plan in response to an actual incident.\"},\"activation_condition\":\"A.Incident Severity in (Medium, High)\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If 'Monitor Risks' activity occurs with the condition that A.Monitoring Frequency <= 7 in a process instance, then 'Identify Risks' must also occur in the same process instance, and vice versa.\",\"template\":\"Co-Existence\",\"activation\":{\"name\":\"Monitor Risks\",\"description\":\"The 'Monitor Risks' activity involves ongoing surveillance of identified risks to detect any changes or emerging threats.\"},\"target\":{\"name\":\"Identify Risks\",\"description\":\"The 'Identify Risks' activity represents the initial phase of pinpointing potential threats and vulnerabilities in the business continuity management process.\"},\"activation_condition\":\"A.Monitoring Frequency <= 7\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"An 'Activate Continuity Plan' activity with the condition that A.Incident Severity is High cannot be immediately followed by an 'Evaluate Incident Response' activity; there must be at least one other event between them. Similarly, an 'Evaluate Incident Response' event cannot be immediately preceded by an 'Activate Continuity Plan' event with that condition. This constraint allows multiple occurrences of 'Activate Continuity Plan' and 'Evaluate Incident Response' in any order, provided they are not adjacent in the event sequence. This must be considered within a time frame of 10 to 15 seconds.\",\"template\":\"Not Chain Succession\",\"activation\":{\"name\":\"Activate Continuity Plan\",\"description\":\"The 'Activate Continuity Plan' activity triggers the execution of the continuity plan in response to an actual incident.\"},\"target\":{\"name\":\"Evaluate Incident Response\",\"description\":\"The 'Evaluate Incident Response' activity assesses the performance and outcomes of the activated continuity plan after an incident.\"},\"activation_condition\":\"A.Incident Severity is High\",\"correlation_condition\":null,\"time_condition\":\"10,15,s\",\"cardinality\":null},{\"type\":\"unary\",\"description\":\"The 'Conduct Training' activity must occur at least once in the process where the activation condition is A.Training Hours >= 8.\",\"template\":\"Existence\",\"activation\":{\"name\":\"Conduct Training\",\"description\":\"The 'Conduct Training' activity includes educating staff on the continuity plan and their roles during an incident.\"},\"target\":null,\"activation_condition\":\"A.Training Hours >= 8\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":1}]}"