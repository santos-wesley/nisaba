tion\":\"10,15,s\",\"cardinality\":null},{\"type\":\"unary\",\"description\":\"The 'Conduct Training' must occur at least once in the process if Training Hours >= 8, but since this is data-driven, the existence is conditioned on the attribute value in relevant executions.\",\"template\":\"Existence\",\"activation\":{\"name\":\"Conduct Training\",\"description\":\"The 'Conduct Training' activity trains staff on the continuity plan, involving Training Hours between 1 and 40.\"},\"target\":null,\"activation_condition\":\"A.Training Hours >= 8\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":1}]}"