"{\"activities\":[{\"name\":\"Plan Eco-Friendly Trip\",\"description\":\"The activity to plan an eco-friendly trip, specifying trip duration and carbon emission budget.\"},{\"name\":\"Book Sustainable Accommodation\",\"description\":\"The activity to book sustainable accommodation, choosing an accommodation type.\"},{\"name\":\"Choose Green Transportation\",\"description\":\"The activity to choose green transportation, selecting a transportation mode.\"},{\"name\":\"Provide Feedback to Hosts\",\"description\":\"The activity to provide feedback to hosts with a rating.\"},{\"name\":\"Evaluate Environmental Impact\",\"description\":\"The activity to evaluate the environmental impact of the trip.\"},{\"name\":\"Participate in Local Conservation Efforts\",\"description\":\"The activity to participate in local conservation efforts.\"},{\"name\":\"Attend Cultural Workshops\",\"description\":\"The activity to attend cultural workshops.\"},{\"name\":\"Purchase Local Products\",\"description\":\"The activity to purchase local products.\"},{\"name\":\"Share Sustainable Practices\",\"description\":\"The activity to share sustainable practices at the end of the process.\"}],\"attributes\":[{\"type\":\"integer\",\"name\":\"Trip Duration\",\"description\":\"The duration of the trip in days.\",\"min_value\":1,\"max_value\":30,\"enumeration_values\":null},{\"type\":\"float\",\"name\":\"Carbon Emission\",\"description\":\"The carbon emission budget for the trip.\",\"min_value\":0.0,\"max_value\":1000.0,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Accommodation Type\",\"description\":\"The type of accommodation booked.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Eco-Lodge\",\"Green Hotel\",\"Hostel\"]},{\"type\":\"enumeration\",\"name\":\"Transportation Mode\",\"description\":\"The mode of green transportation chosen.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Bicycle\",\"Electric Car\",\"Train\"]},{\"type\":\"enumeration\",\"name\":\"Feedback Rating\",\"description\":\"The rating given in feedback to hosts.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Excellent\",\"Good\",\"Average\",\"Poor\"]}],\"binds\":[{\"activity\":{\"name\":\"Plan Eco-Friendly Trip\",\"description\":\"The activity to plan an eco-friendly trip, specifying trip duration and carbon emission budget.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Trip Duration\",\"description\":\"The duration of the trip in days.\",\"min_value\":1,\"max_value\":30,\"enumeration_values\":null},{\"type\":\"float\",\"name\":\"Carbon Emission\",\"description\":\"The carbon emission budget for the trip.\",\"min_value\":0.0,\"max_value\":1000.0,\"enumeration_values\":null}],\"description\":\"The bind 'Plan Eco-Friendly Trip: Trip Duration, Carbon Emission' links the planning activity with trip duration and carbon emission attributes.\"},{\"activity\":{\"name\":\"Book Sustainable Accommodation\",\"description\":\"The activity to book sustainable accommodation, choosing an accommodation type.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Accommodation Type\",\"description\":\"The type of accommodation booked.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Eco-Lodge\",\"Green Hotel\",\"Hostel\"]}],\"description\":\"The bind 'Book Sustainable Accommodation: Accommodation Type' links the booking activity with accommodation type attribute.\"},{\"activity\":{\"name\":\"Choose Green Transportation\",\"description\":\"The activity to choose green transportation, selecting a transportation mode.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Transportation Mode\",\"description\":\"The mode of green transportation chosen.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Bicycle\",\"Electric Car\",\"Train\"]}],\"description\":\"The bind 'Choose Green Transportation: Transportation Mode' links the transportation activity with transportation mode attribute.\"},{\"activity\":{\"name\":\"Provide Feedback to Hosts\",\"description\":\"The activity to provide feedback to hosts with a rating.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Feedback Rating\",\"description\":\"The rating given in feedback to hosts.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Excellent\",\"Good\",\"Average\",\"Poor\"]}],\"description\":\"The bind 'Provide Feedback to Hosts: Feedback Rating' links the feedback activity with the feedback rating attribute.\"}],\"constraints\":[{\"type\":\"unary\",\"description\":\"The 'Plan Eco-Friendly Trip' must be the first activity to occur in the process.\",\"template\":\"Init\",\"activation\":{\"name\":\"Plan Eco-Friendly Trip\",\"description\":\"The activity to plan an eco-friendly trip, specifying trip duration and carbon emission budget.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"unary\",\"description\":\"The 'Share Sustainable Practices' must be the last activity to occur in the process.\",\"template\":\"End\",\"activation\":{\"name\":\"Share Sustainable Practices\",\"description\":\"The activity to share sustainable practices at the end of the process.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"Exactly one of the activities 'Book Sustainable Accommodation' or 'Choose Green Transportation' must occur in the process instance. This means that the process is compliant if only 'Book Sustainable Accommodation' occurs without any occurrence of 'Choose Green Transportation', or only 'Choose Green Transportation' occurs without any occurrence of 'Book Sustainable Accommodation'. The process is non-compliant if both occur, or if neither occurs. The constraint enforces a mutual exclusivity and a mandatory occurrence of one of the specified activities.\",\"template\":\"Exclusive Choice\",\"activation\":{\"name\":\"Book Sustainable Accommodation\",\"description\":\"The activity to book sustainable accommodation, choosing an accommodation type.\"},\"target\":{\"name\":\"Choose Green Transportation\",\"description\":\"The activity to choose green transportation, selecting a transportation mode.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"Whenever a 'Book Sustainable Accommodation' activity occurs, it must be immediately followed by a 'Provide Feedback to Hosts' activity in the next event position, with no other events in between. The 'Provide Feedback to Hosts' activity is allowed to happen isolated.\",\"template\":\"Chain Response\",\"activation\":{\"name\":\"Book Sustainable Accommodation\",\"description\":\"The activity to book sustainable accommodation, choosing an accommodation type.\"},\"target\":{\"name\":\"Provide Feedback to Hosts\",\"description\":\"The activity to provide feedback to hosts with a rating.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Choose Green Transportation' activity occurs, then a 'Evaluate Environmental Impact' activity must eventually occur after the 'Choose Green Transportation' event at some point in the same process instance. There is no requirement on how soon or what events may occur in between. If 'Choose Green Transportation' does not occur, the constraint imposes no obligation on the occurrence of 'Evaluate Environmental Impact'.\",\"template\":\"Response\",\"activation\":{\"name\":\"Choose Green Transportation\",\"description\":\"The activity to choose green transportation, selecting a transportation mode.\"},\"target\":{\"name\":\"Evaluate Environmental Impact\",\"description\":\"The activity to evaluate the environmental impact of the trip.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Provide Feedback to Hosts' activity with Feedback Rating is 'Poor' occurs in a process instance, then a 'Evaluate Environmental Impact' activity must not occur anywhere in the same process instance. This means that the occurrence of providing poor feedback prohibits any occurrence of evaluating environmental impact. However, if no poor feedback is provided, evaluating environmental impact may occur freely.\",\"template\":\"Not Responded Existence\",\"activation\":{\"name\":\"Provide Feedback to Hosts\",\"description\":\"The activity to provide feedback to hosts with a rating.\"},\"target\":{\"name\":\"Evaluate Environmental Impact\",\"description\":\"The activity to evaluate the environmental impact of the trip.\"},\"activation_condition\":\"A.Feedback Rating is Poor\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If 'Participate in Local Conservation Efforts' activity occurs in a process instance, then 'Attend Cultural Workshops' must also occur in the same process instance, and vice-versa. This mutual obligation ensures that neither event can occur without the other.\",\"template\":\"Co-Existence\",\"activation\":{\"name\":\"Participate in Local Conservation Efforts\",\"description\":\"The activity to participate in local conservation efforts.\"},\"target\":{\"name\":\"Attend Cultural Workshops\",\"description\":\"The activity to attend cultural workshops.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Plan Eco-Friendly Trip' activity occurs with Trip Duration greater than 7, then a 'Participate in Local Conservation Efforts' activity must eventually occur after the planning event at some point in the same process instance.\",\"template\":\"Response\",\"activation\":{\"name\":\"Plan Eco-Friendly Trip\",\"description\":\"The activity to plan an eco-friendly trip, specifying trip duration and carbon emission budget.\"},\"target\":{\"name\":\"Participate in Local Conservation Efforts\",\"description\":\"The activity to participate in local conservation efforts.\"},\"activation_condition\":\"A.Trip Duration > 7\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Plan Eco-Friendly Trip' activity cannot be directly followed by a 'Purchase Local Products' activity, meaning that a 'Purchase Local Products' event cannot occur immediately after a 'Plan Eco-Friendly Trip' without any intervening events.\",\"template\":\"Not Chain Response\",\"activation\":{\"name\":\"Plan Eco-Friendly Trip\",\"description\":\"The activity to plan an eco-friendly trip, specifying trip duration and carbon emission budget.\"},\"target\":{\"name\":\"Purchase Local Products\",\"description\":\"The activity to purchase local products.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"unary\",\"description\":\"The 'Evaluate Environmental Impact' activity must occur at least once in the process.\",\"template\":\"Existence\",\"activation\":{\"name\":\"Evaluate Environmental Impact\",\"description\":\"The activity to evaluate the environmental impact of the trip.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":1}]}"