ute 'Home Visit Outcome'.\"},{\"activity\":{\"name\":\"Close Client File\",\"description\":\"The 'Close Client File' activity represents the final step of concluding the client's case and archiving their records.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"File Closure Reason\",\"description\":\"The attribute 'File Closure Reason: Goals Met, Client Moved, Services Declined' specifies the reason for closing the client's file.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Goals Met\",\"Client Moved\",\"Services Declined\"]}],\"description\":\"The bind 'Close Client File: File Closure Reason' links the 'Close Client File' activity with the attribute 'File Closure Reason'.\"},{\"activity\":{\"name\":\"Refer to Specialist\",\"description\":\"The 'Refer to Specialist' activity involves directing the client to a specialized professional for additional support.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Specialist Type\",\"description\":\"The attribute 'Specialist Type: Psychiatrist, Addiction Counselor, Legal Aid' specifies the type of specialist to whom the client is referred.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Psychiatrist\",\"Addiction Counselor\",\"Legal Aid\"]}],\"description\":\"The bind 'Refer to Specialist: Specialist Type' links the 'Refer to Specialist' activity with the attribute 'Specialist Type'.\"}],\"constraints\":[{\"type\":\"unary\",\"description\":\"The 'Assess Client Needs' must be the first activity to occur in the process.\",\"template\":\"Init\",\"activation\":{\"name\":\"Assess Client Needs\",\"description\":\"The 'Assess Client Needs' activity represents the initial evaluation to understand the client's requirements and circumstances.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Develop Service Plan' activity is permitted to occur only if a 'Assess Cli