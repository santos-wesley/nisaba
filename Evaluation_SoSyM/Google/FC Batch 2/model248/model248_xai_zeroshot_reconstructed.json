.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Batch Number\",\"description\":\"The attribute 'Batch Number' is an identifier for the stored product batch, ranging from 1 to 1000.\",\"min_value\":1,\"max_value\":1000,\"enumeration_values\":null}],\"description\":\"The bind 'Store Product: Batch Number' links the 'Store Product' activity with attribute 'Batch Number'.\"}],\"constraints\":[{\"type\":\"unary\",\"description\":\"The 'Prepare Solution' must be the first activity to occur in the process.\",\"template\":\"Init\",\"activation\":{\"name\":\"Prepare Solution\",\"description\":\"The 'Prepare Solution' activity represents the initial step of preparing a chemical solution with specified concentration and solvent type.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"Each occurrence of a 'Prepare Solution' activity must eventually be followed by a 'Heat Mixture' activity, and each occurrence of a 'Heat Mixture' must be preceded by 'Prepare Solution', with no intermediate occurrences of 'Prepare Solution' or 'Heat Mixture' between them.\",\"template\":\"Succession\",\"activation\":{\"name\":\"Prepare Solution\",\"description\":\"The 'Prepare Solution' activity represents the initial step of preparing a chemical solution with specified concentration and solvent type.\"},\"target\":{\"name\":\"Heat Mixture\",\"description\":\"The 'Heat Mixture' activity involves heating the prepared mixture to a specific temperature for a given reaction time.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Heat Mixture' activity occurs, then a 'Add Catalyst' activity must eventually occur after the 'Heat Mixture' event at some point in the same process instance. There is no requirement on how soon or what events may occur in between. Multiple 'Heat Mixture'