"{\"activities\":[{\"name\":\"Monitor Seismic Activity\",\"description\":\"The activity 'Monitor Seismic Activity' represents continuously tracking seismic events to detect potential disasters.\"},{\"name\":\"Issue Early Warning\",\"description\":\"The activity 'Issue Early Warning' involves alerting relevant authorities and the public about an impending seismic event based on monitored data.\"},{\"name\":\"Activate Emergency Response\",\"description\":\"The activity 'Activate Emergency Response' initiates the coordinated emergency procedures following an early warning.\"},{\"name\":\"Deploy Rescue Teams\",\"description\":\"The activity 'Deploy Rescue Teams' involves sending specialized teams to affected areas to perform search and rescue operations.\"},{\"name\":\"Provide Medical Assistance\",\"description\":\"The activity 'Provide Medical Assistance' focuses on delivering urgent medical care to injured individuals in the disaster zone.\"},{\"name\":\"Distribute Relief Supplies\",\"description\":\"The activity 'Distribute Relief Supplies' entails delivering essential goods such as food, water, and blankets to affected populations.\"},{\"name\":\"Assess Disaster Risk\",\"description\":\"The activity 'Assess Disaster Risk' evaluates the potential impact and likelihood of severe consequences from the seismic event using monitored data.\"},{\"name\":\"Evacuate Affected Population\",\"description\":\"The activity 'Evacuate Affected Population' involves moving people from high-risk zones to safer locations.\"},{\"name\":\"Establish Temporary Shelters\",\"description\":\"The activity 'Establish Temporary Shelters' sets up safe, temporary housing for displaced individuals.\"},{\"name\":\"Conduct Damage Assessment\",\"description\":\"The activity 'Conduct Damage Assessment' inspects and quantifies the physical damage caused by the seismic event.\"}],\"attributes\":[{\"type\":\"float\",\"name\":\"Seismic Magnitude\",\"description\":\"The attribute 'Seismic Magnitude' records the intensity of the seismic event on a scale from 0 to 10.\",\"min_value\":0.0,\"max_value\":10.0,\"enumeration_values\":null},{\"type\":\"float\",\"name\":\"Risk Score\",\"description\":\"The attribute 'Risk Score' quantifies the assessed level of disaster risk on a scale from 0.0 to 100.0.\",\"min_value\":0.0,\"max_value\":100.0,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Warning Level\",\"description\":\"The attribute 'Warning Level' indicates the severity of the early warning issued, with values Low, Medium, High, Critical.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Low\",\"Medium\",\"High\",\"Critical\"]},{\"type\":\"enumeration\",\"name\":\"Response Status\",\"description\":\"The attribute 'Response Status' tracks the progress of the emergency response, with values Initiated, Ongoing, Completed.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Initiated\",\"Ongoing\",\"Completed\"]},{\"type\":\"integer\",\"name\":\"Teams Deployed\",\"description\":\"The attribute 'Teams Deployed' records the number of rescue teams sent to the field, ranging from 0 to 50.\",\"min_value\":0,\"max_value\":50,\"enumeration_values\":null},{\"type\":\"integer\",\"name\":\"Injured Count\",\"description\":\"The attribute 'Injured Count' tracks the number of injured people receiving medical aid, ranging from 0 to 10000.\",\"min_value\":0,\"max_value\":10000,\"enumeration_values\":null},{\"type\":\"integer\",\"name\":\"Supplies Distributed\",\"description\":\"The attribute 'Supplies Distributed' records the volume of relief items provided, ranging from 0 to 20000.\",\"min_value\":0,\"max_value\":20000,\"enumeration_values\":null},{\"type\":\"integer\",\"name\":\"People Evacuated\",\"description\":\"The attribute 'People Evacuated' tracks the number of individuals moved to safety, ranging from 0 to 50000.\",\"min_value\":0,\"max_value\":50000,\"enumeration_values\":null},{\"type\":\"integer\",\"name\":\"Shelters Established\",\"description\":\"The attribute 'Shelters Established' records the number of temporary shelters set up, ranging from 0 to 20.\",\"min_value\":0,\"max_value\":20,\"enumeration_values\":null},{\"type\":\"float\",\"name\":\"Damage Estimate\",\"description\":\"The attribute 'Damage Estimate' quantifies the monetary or structural damage in currency units or equivalent, ranging from 0.0 to 1000000000.0.\",\"min_value\":0.0,\"max_value\":1000000000.0,\"enumeration_values\":null}],\"binds\":[{\"activity\":{\"name\":\"Monitor Seismic Activity\",\"description\":\"The activity 'Monitor Seismic Activity' represents continuously tracking seismic events to detect potential disasters.\"},\"attributes\":[{\"type\":\"float\",\"name\":\"Seismic Magnitude\",\"description\":\"The attribute 'Seismic Magnitude' records the intensity of the seismic event on a scale from 0 to 10.\",\"min_value\":0.0,\"max_value\":10.0,\"enumeration_values\":null}],\"description\":\"The bind 'Monitor Seismic Activity: Seismic Magnitude' links the monitoring activity to the seismic intensity measurement.\"},{\"activity\":{\"name\":\"Assess Disaster Risk\",\"description\":\"The activity 'Assess Disaster Risk' evaluates the potential impact and likelihood of severe consequences from the seismic event using monitored data.\"},\"attributes\":[{\"type\":\"float\",\"name\":\"Risk Score\",\"description\":\"The attribute 'Risk Score' quantifies the assessed level of disaster risk on a scale from 0.0 to 100.0.\",\"min_value\":0.0,\"max_value\":100.0,\"enumeration_values\":null}],\"description\":\"The bind 'Assess Disaster Risk: Risk Score' associates the risk evaluation activity with its computed risk metric.\"},{\"activity\":{\"name\":\"Issue Early Warning\",\"description\":\"The activity 'Issue Early Warning' involves alerting relevant authorities and the public about an impending seismic event based on monitored data.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Warning Level\",\"description\":\"The attribute 'Warning Level' indicates the severity of the early warning issued, with values Low, Medium, High, Critical.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Low\",\"Medium\",\"High\",\"Critical\"]}],\"description\":\"The bind 'Issue Early Warning: Warning Level' connects the warning issuance to the categorized alert severity.\"},{\"activity\":{\"name\":\"Activate Emergency Response\",\"description\":\"The activity 'Activate Emergency Response' initiates the coordinated emergency procedures following an early warning.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Response Status\",\"description\":\"The attribute 'Response Status' tracks the progress of the emergency response, with values Initiated, Ongoing, Completed.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Initiated\",\"Ongoing\",\"Completed\"]}],\"description\":\"The bind 'Activate Emergency Response: Response Status' ties the activation step to the current state of the response effort.\"},{\"activity\":{\"name\":\"Deploy Rescue Teams\",\"description\":\"The activity 'Deploy Rescue Teams' involves sending specialized teams to affected areas to perform search and rescue operations.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Teams Deployed\",\"description\":\"The attribute 'Teams Deployed' records the number of rescue teams sent to the field, ranging from 0 to 50.\",\"min_value\":0,\"max_value\":50,\"enumeration_values\":null}],\"description\":\"The bind 'Deploy Rescue Teams: Teams Deployed' links the deployment action to the count of teams in action.\"},{\"activity\":{\"name\":\"Provide Medical Assistance\",\"description\":\"The activity 'Provide Medical Assistance' focuses on delivering urgent medical care to injured individuals in the disaster zone.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Injured Count\",\"description\":\"The attribute 'Injured Count' tracks the number of injured people receiving medical aid, ranging from 0 to 10000.\",\"min_value\":0,\"max_value\":10000,\"enumeration_values\":null}],\"description\":\"The bind 'Provide Medical Assistance: Injured Count' associates medical aid provision with the number of casualties treated.\"},{\"activity\":{\"name\":\"Distribute Relief Supplies\",\"description\":\"The activity 'Distribute Relief Supplies' entails delivering essential goods such as food, water, and blankets to affected populations.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Supplies Distributed\",\"description\":\"The attribute 'Supplies Distributed' records the volume of relief items provided, ranging from 0 to 20000.\",\"min_value\":0,\"max_value\":20000,\"enumeration_values\":null}],\"description\":\"The bind 'Distribute Relief Supplies: Supplies Distributed' connects supply distribution to the quantity of items handed out.\"},{\"activity\":{\"name\":\"Evacuate Affected Population\",\"description\":\"The activity 'Evacuate Affected Population' involves moving people from high-risk zones to safer locations.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"People Evacuated\",\"description\":\"The attribute 'People Evacuated' tracks the number of individuals moved to safety, ranging from 0 to 50000.\",\"min_value\":0,\"max_value\":50000,\"enumeration_values\":null}],\"description\":\"The bind 'Evacuate Affected Population: People Evacuated' links the evacuation process to the count of people relocated.\"},{\"activity\":{\"name\":\"Establish Temporary Shelters\",\"description\":\"The activity 'Establish Temporary Shelters' sets up safe, temporary housing for displaced individuals.\"},\"attributes\":[{\"type\":\"integer\",\"name\":\"Shelters Established\",\"description\":\"The attribute 'Shelters Established' records the number of temporary shelters set up, ranging from 0 to 20.\",\"min_value\":0,\"max_value\":20,\"enumeration_values\":null}],\"description\":\"The bind 'Establish Temporary Shelters: Shelters Established' associates shelter setup with the number of facilities created.\"},{\"activity\":{\"name\":\"Conduct Damage Assessment\",\"description\":\"The activity 'Conduct Damage Assessment' inspects and quantifies the physical damage caused by the seismic event.\"},\"attributes\":[{\"type\":\"float\",\"name\":\"Damage Estimate\",\"description\":\"The attribute 'Damage Estimate' quantifies the monetary or structural damage in currency units or equivalent, ranging from 0.0 to 1000000000.0.\",\"min_value\":0.0,\"max_value\":1000000000.0,\"enumeration_values\":null}],\"description\":\"The bind 'Conduct Damage Assessment: Damage Estimate' ties the assessment activity to the calculated extent of losses.\"}],\"constraints\":[{\"type\":\"unary\",\"description\":\"The 'Monitor Seismic Activity' must be the first activity to occur in the process.\",\"template\":\"Init\",\"activation\":{\"name\":\"Monitor Seismic Activity\",\"description\":\"The activity 'Monitor Seismic Activity' represents continuously tracking seismic events to detect potential disasters.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If an 'Issue Early Warning' activity occurs, then an 'Activate Emergency Response' activity must eventually occur after the 'Issue Early Warning' at some point in the same process instance. There is no requirement on how soon or what events may occur in between. Multiple 'Issue Early Warning' can be pending at the same time, and a single 'Activate Emergency Response' can fulfill the obligation for all preceding 'Issue Early Warning'. If 'Issue Early Warning' does not occur, the constraint imposes no obligation on the occurrence of 'Activate Emergency Response'.\",\"template\":\"Response\",\"activation\":{\"name\":\"Issue Early Warning\",\"description\":\"The activity 'Issue Early Warning' involves alerting relevant authorities and the public about an impending seismic event based on monitored data.\"},\"target\":{\"name\":\"Activate Emergency Response\",\"description\":\"The activity 'Activate Emergency Response' initiates the coordinated emergency procedures following an early warning.\"},\"activation_condition\":\"A.Warning Level is Medium OR A.Warning Level is High OR A.Warning Level is Critical\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Activate Emergency Response' activity must be followed by a 'Deploy Rescue Teams' activity at some point later in the same process instance. Conversely, a 'Deploy Rescue Teams' event can occur only if an 'Activate Emergency Response' event has occurred before it within the same process instance.\",\"template\":\"Succession\",\"activation\":{\"name\":\"Activate Emergency Response\",\"description\":\"The activity 'Activate Emergency Response' initiates the coordinated emergency procedures following an early warning.\"},\"target\":{\"name\":\"Deploy Rescue Teams\",\"description\":\"The activity 'Deploy Rescue Teams' involves sending specialized teams to affected areas to perform search and rescue operations.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Deploy Rescue Teams' activity must be followed by a 'Provide Medical Assistance' activity at some point later in the same process instance. Conversely, a 'Provide Medical Assistance' event can occur only if a 'Deploy Rescue Teams' event has occurred before it within the same process instance.\",\"template\":\"Succession\",\"activation\":{\"name\":\"Deploy Rescue Teams\",\"description\":\"The activity 'Deploy Rescue Teams' involves sending specialized teams to affected areas to perform search and rescue operations.\"},\"target\":{\"name\":\"Provide Medical Assistance\",\"description\":\"The activity 'Provide Medical Assistance' focuses on delivering urgent medical care to injured individuals in the disaster zone.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Provide Medical Assistance' activity must be followed by a 'Distribute Relief Supplies' activity at some point later in the same process instance. Conversely, a 'Distribute Relief Supplies' event can occur only if a 'Provide Medical Assistance' event has occurred before it within the same process instance. This pair must occur within a 24-hour window.\",\"template\":\"Succession\",\"activation\":{\"name\":\"Provide Medical Assistance\",\"description\":\"The activity 'Provide Medical Assistance' focuses on delivering urgent medical care to injured individuals in the disaster zone.\"},\"target\":{\"name\":\"Distribute Relief Supplies\",\"description\":\"The activity 'Distribute Relief Supplies' entails delivering essential goods such as food, water, and blankets to affected populations.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":\"0,24,h\",\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Assess Disaster Risk' activity is permitted to occur only if a 'Monitor Seismic Activity' activity has occurred before it within the same process instance.\",\"template\":\"Precedence\",\"activation\":{\"name\":\"Assess Disaster Risk\",\"description\":\"The activity 'Assess Disaster Risk' evaluates the potential impact and likelihood of severe consequences from the seismic event using monitored data.\"},\"target\":{\"name\":\"Monitor Seismic Activity\",\"description\":\"The activity 'Monitor Seismic Activity' represents continuously tracking seismic events to detect potential disasters.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If an 'Assess Disaster Risk' occurs with Risk Score > 70, then both 'Evacuate Affected Population' and 'Establish Temporary Shelters' must eventually occur in the same process instance (modeled via two Responded Existence constraints).\",\"template\":\"Responded Existence\",\"activation\":{\"name\":\"Assess Disaster Risk\",\"description\":\"The activity 'Assess Disaster Risk' evaluates the potential impact and likelihood of severe consequences from the seismic event using monitored data.\"},\"target\":{\"name\":\"Evacuate Affected Population\",\"description\":\"The activity 'Evacuate Affected Population' involves moving people from high-risk zones to safer locations.\"},\"activation_condition\":\"A.Risk Score > 70\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If an 'Assess Disaster Risk' occurs with Risk Score > 70, then both 'Evacuate Affected Population' and 'Establish Temporary Shelters' must eventually occur in the same process instance (modeled via two Responded Existence constraints).\",\"template\":\"Responded Existence\",\"activation\":{\"name\":\"Assess Disaster Risk\",\"description\":\"The activity 'Assess Disaster Risk' evaluates the potential impact and likelihood of severe consequences from the seismic event using monitored data.\"},\"target\":{\"name\":\"Establish Temporary Shelters\",\"description\":\"The activity 'Establish Temporary Shelters' sets up safe, temporary housing for displaced individuals.\"},\"activation_condition\":\"A.Risk Score > 70\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"A 'Conduct Damage Assessment' activity must be followed by a 'Distribute Relief Supplies' activity at some point later in the same process instance. Conversely, a 'Distribute Relief Supplies' event can occur only if a 'Conduct Damage Assessment' event has occurred before it within the same process instance. This ensures damage assessment precedes further relief distribution and cannot be repeated after distribution begins.\",\"template\":\"Succession\",\"activation\":{\"name\":\"Conduct Damage Assessment\",\"description\":\"The activity 'Conduct Damage Assessment' inspects and quantifies the physical damage caused by the seismic event.\"},\"target\":{\"name\":\"Distribute Relief Supplies\",\"description\":\"The activity 'Distribute Relief Supplies' entails delivering essential goods such as food, water, and blankets to affected populations.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null}]}"