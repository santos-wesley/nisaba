"{\"activities\":[{\"name\":\"Report Disease Outbreak\",\"description\":\"The activity where the initial report of a disease outbreak is received from sources such as Hospital, Clinic, Public, or Other, along with the number of cases.\"},{\"name\":\"Verify Outbreak Report\",\"description\":\"The activity that verifies the reported outbreak, resulting in an Investigation Result of Confirmed, False Alarm, or Inconclusive.\"},{\"name\":\"Initiate Investigation\",\"description\":\"The activity that starts a formal investigation into the confirmed outbreak.\"},{\"name\":\"Collect Samples\",\"description\":\"The activity where field teams collect samples for analysis following the initiation of an investigation.\"},{\"name\":\"Analyze Samples\",\"description\":\"The activity that analyzes the collected samples to provide data for disease confirmation.\"},{\"name\":\"Confirm Disease\",\"description\":\"The activity that confirms the disease based on analysis, recording the Disease Type (Influenza, COVID-19, Measles, or Cholera) and Mortality Rate.\"},{\"name\":\"Implement Control Measures\",\"description\":\"The activity that implements control measures such as Vaccination, Quarantine, Hygiene Campaign, or Social Distancing, and records the days required to control the outbreak.\"},{\"name\":\"Inform Public\",\"description\":\"The activity that informs the public about the outbreak and control measures, capturing the Public Response (Cooperative, Anxious, or Resistant).\"},{\"name\":\"Monitor Disease Spread\",\"description\":\"The activity that monitors the spread of the disease after informing the public.\"},{\"name\":\"Declare End of Outbreak\",\"description\":\"The final activity that officially declares the end of the outbreak.\"}],\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Report Source\",\"description\":\"The source of the disease outbreak report.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Hospital\",\"Clinic\",\"Public\",\"Other\"]},