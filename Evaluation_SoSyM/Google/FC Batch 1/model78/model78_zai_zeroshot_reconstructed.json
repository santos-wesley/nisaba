"{\"activities\":[{\"name\":\"Report Disease Outbreak\",\"description\":\"The 'Report Disease Outbreak' activity represents the initial reporting of a disease outbreak, capturing the source of the report and the number of cases detected.\"},{\"name\":\"Verify Outbreak Report\",\"description\":\"The 'Verify Outbreak Report' activity involves verifying the validity of a reported disease outbreak by recording the investigation result.\"},{\"name\":\"Initiate Investigation\",\"description\":\"The 'Initiate Investigation' activity begins a formal investigation into a confirmed disease outbreak.\"},{\"name\":\"Collect Samples\",\"description\":\"The 'Collect Samples' activity involves collecting biological or environmental samples for laboratory analysis during the outbreak investigation.\"},{\"name\":\"Analyze Samples\",\"description\":\"The 'Analyze Samples' activity involves laboratory analysis of collected samples to identify the pathogen and confirm the disease.\"},{\"name\":\"Confirm Disease\",\"description\":\"The 'Confirm Disease' activity identifies the specific disease type and records the associated mortality rate based on laboratory analysis results.\"},{\"name\":\"Implement Control Measures\",\"description\":\"The 'Implement Control Measures' activity specifies and applies public health control measures such as vaccination, quarantine, hygiene campaigns, or social distancing, and records the estimated days to control the outbreak.\"},{\"name\":\"Inform Public\",\"description\":\"The 'Inform Public' activity communicates information about the outbreak and control measures to the public, tracking the public response.\"},{\"name\":\"Monitor Disease Spread\",\"description\":\"The 'Monitor Disease Spread' activity tracks the progression and spread of the disease over time to assess the effectiveness of control measures.\"},{\"name\":\"Declare End of Outbreak\",\"description\":\"The 'Declare End of Outbreak' activity officially declares the end of the disease outbreak, marking the conclusion of the emergency response process.\"}],\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Report Source\",\"description\":\"The attribute 'Report Source' specifies the origin of the disease outbreak report, with possible values: Hospital, Clinic, Public, or Other.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Hospital\",\"Clinic\",\"Public\",\"Other\"]},{\"type\":\"integer\",\"name\":\"Number of Cases\",\"description\":\"The attribute 'Number of Cases' represents the number of reported cases associated with the disease outbreak, as an integer between 1 and 1000.\",\"min_value\":1,\"max_value\":1000,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Investigation Result\",\"description\":\"The attribute 'Investigation Result' records the outcome of the outbreak report verification, with possible values: Confirmed, False Alarm, or Inconclusive.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Confirmed\",\"False Alarm\",\"Inconclusive\"]},{\"type\":\"enumeration\",\"name\":\"Disease Type\",\"description\":\"The attribute 'Disease Type' identifies the type of disease associated with the outbreak, with possible values: Influenza, COVID-19, Measles, or Cholera.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Influenza\",\"COVID-19\",\"Measles\",\"Cholera\"]},{\"type\":\"float\",\"name\":\"Mortality Rate\",\"description\":\"The attribute 'Mortality Rate' represents the mortality rate associated with the confirmed disease, as a float between 0.0 and 100.0.\",\"min_value\":0.0,\"max_value\":100.0,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Control Measures\",\"description\":\"The attribute 'Control Measures' specifies the type of control measures implemented, with possible values: Vaccination, Quarantine, Hygiene Campaign, or Social Distancing.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Vaccination\",\"Quarantine\",\"Hygiene Campaign\",\"Social Distancing\"]},{\"type\":\"integer\",\"name\":\"Days to Control\",\"description\":\"The attribute 'Days to Control' represents the estimated number of days to control the outbreak, as an integer between 1 and 365.\",\"min_value\":1,\"max_value\":365,\"enumeration_values\":null},{\"type\":\"enumeration\",\"name\":\"Public Response\",\"description\":\"The attribute 'Public Response' tracks the public's response to the outbreak communication, with possible values: Cooperative, Anxious, or Resistant.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Cooperative\",\"Anxious\",\"Resistant\"]}],\"binds\":[{\"activity\":{\"name\":\"Report Disease Outbreak\",\"description\":\"The 'Report Disease Outbreak' activity represents the initial reporting of a disease outbreak, capturing the source of the report and the number of cases detected.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Report Source\",\"description\":\"The attribute 'Report Source' specifies the origin of the disease outbreak report, with possible values: Hospital, Clinic, Public, or Other.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Hospital\",\"Clinic\",\"Public\",\"Other\"]},{\"type\":\"integer\",\"name\":\"Number of Cases\",\"description\":\"The attribute 'Number of Cases' represents the number of reported cases associated with the disease outbreak, as an integer between 1 and 1000.\",\"min_value\":1,\"max_value\":1000,\"enumeration_values\":null}],\"description\":\"The bind 'Report Disease Outbreak: Report Source, Number of Cases' links the 'Report Disease Outbreak' activity with the attributes 'Report Source' and 'Number of Cases' to capture the origin and scale of the reported outbreak.\"},{\"activity\":{\"name\":\"Verify Outbreak Report\",\"description\":\"The 'Verify Outbreak Report' activity involves verifying the validity of a reported disease outbreak by recording the investigation result.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Investigation Result\",\"description\":\"The attribute 'Investigation Result' records the outcome of the outbreak report verification, with possible values: Confirmed, False Alarm, or Inconclusive.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Confirmed\",\"False Alarm\",\"Inconclusive\"]}],\"description\":\"The bind 'Verify Outbreak Report: Investigation Result' links the 'Verify Outbreak Report' activity with the attribute 'Investigation Result' to record the outcome of the verification process.\"},{\"activity\":{\"name\":\"Confirm Disease\",\"description\":\"The 'Confirm Disease' activity identifies the specific disease type and records the associated mortality rate based on laboratory analysis results.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Disease Type\",\"description\":\"The attribute 'Disease Type' identifies the type of disease associated with the outbreak, with possible values: Influenza, COVID-19, Measles, or Cholera.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Influenza\",\"COVID-19\",\"Measles\",\"Cholera\"]},{\"type\":\"float\",\"name\":\"Mortality Rate\",\"description\":\"The attribute 'Mortality Rate' represents the mortality rate associated with the confirmed disease, as a float between 0.0 and 100.0.\",\"min_value\":0.0,\"max_value\":100.0,\"enumeration_values\":null}],\"description\":\"The bind 'Confirm Disease: Disease Type, Mortality Rate' links the 'Confirm Disease' activity with the attributes 'Disease Type' and 'Mortality Rate' to identify the disease and its associated mortality rate.\"},{\"activity\":{\"name\":\"Implement Control Measures\",\"description\":\"The 'Implement Control Measures' activity specifies and applies public health control measures such as vaccination, quarantine, hygiene campaigns, or social distancing, and records the estimated days to control the outbreak.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Control Measures\",\"description\":\"The attribute 'Control Measures' specifies the type of control measures implemented, with possible values: Vaccination, Quarantine, Hygiene Campaign, or Social Distancing.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Vaccination\",\"Quarantine\",\"Hygiene Campaign\",\"Social Distancing\"]},{\"type\":\"integer\",\"name\":\"Days to Control\",\"description\":\"The attribute 'Days to Control' represents the estimated number of days to control the outbreak, as an integer between 1 and 365.\",\"min_value\":1,\"max_value\":365,\"enumeration_values\":null}],\"description\":\"The bind 'Implement Control Measures: Control Measures, Days to Control' links the 'Implement Control Measures' activity with the attributes 'Control Measures' and 'Days to Control' to specify the measures taken and the estimated timeframe for control.\"},{\"activity\":{\"name\":\"Inform Public\",\"description\":\"The 'Inform Public' activity communicates information about the outbreak and control measures to the public, tracking the public response.\"},\"attributes\":[{\"type\":\"enumeration\",\"name\":\"Public Response\",\"description\":\"The attribute 'Public Response' tracks the public's response to the outbreak communication, with possible values: Cooperative, Anxious, or Resistant.\",\"min_value\":null,\"max_value\":null,\"enumeration_values\":[\"Cooperative\",\"Anxious\",\"Resistant\"]}],\"description\":\"The bind 'Inform Public: Public Response' links the 'Inform Public' activity with the attribute 'Public Response' to track how the public reacts to the outbreak communication.\"}],\"constraints\":[{\"type\":\"unary\",\"description\":\"The 'Report Disease Outbreak' activity must be the first activity to occur in the process, marking the start of the disease outbreak management workflow.\",\"template\":\"Init\",\"activation\":{\"name\":\"Report Disease Outbreak\",\"description\":\"The 'Report Disease Outbreak' activity represents the initial reporting of a disease outbreak, capturing the source of the report and the number of cases detected.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"unary\",\"description\":\"The 'Declare End of Outbreak' activity must be the last activity to occur in the process, marking the official conclusion of the disease outbreak emergency response.\",\"template\":\"End\",\"activation\":{\"name\":\"Declare End of Outbreak\",\"description\":\"The 'Declare End of Outbreak' activity officially declares the end of the disease outbreak, marking the conclusion of the emergency response process.\"},\"target\":null,\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Report Disease Outbreak' activity occurs, then a 'Verify Outbreak Report' activity must eventually occur after it at some point in the same process instance. There is no requirement on how soon or what events may occur in between. Multiple 'Report Disease Outbreak' events can be pending at the same time, and a single 'Verify Outbreak Report' can fulfill the obligation for all preceding reports.\",\"template\":\"Response\",\"activation\":{\"name\":\"Report Disease Outbreak\",\"description\":\"The 'Report Disease Outbreak' activity represents the initial reporting of a disease outbreak, capturing the source of the report and the number of cases detected.\"},\"target\":{\"name\":\"Verify Outbreak Report\",\"description\":\"The 'Verify Outbreak Report' activity involves verifying the validity of a reported disease outbreak by recording the investigation result.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Verify Outbreak Report' activity occurs with the Investigation Result marked as 'Confirmed', then an 'Initiate Investigation' activity must eventually occur after it at some point in the same process instance.\",\"template\":\"Response\",\"activation\":{\"name\":\"Verify Outbreak Report\",\"description\":\"The 'Verify Outbreak Report' activity involves verifying the validity of a reported disease outbreak by recording the investigation result.\"},\"target\":{\"name\":\"Initiate Investigation\",\"description\":\"The 'Initiate Investigation' activity begins a formal investigation into a confirmed disease outbreak.\"},\"activation_condition\":\"A.Investigation Result is Confirmed\",\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"Whenever a 'Collect Samples' activity occurs, an 'Analyze Samples' activity must eventually follow within a time frame of 0 to 48 hours.\",\"template\":\"Response\",\"activation\":{\"name\":\"Collect Samples\",\"description\":\"The 'Collect Samples' activity involves collecting biological or environmental samples for laboratory analysis during the outbreak investigation.\"},\"target\":{\"name\":\"Analyze Samples\",\"description\":\"The 'Analyze Samples' activity involves laboratory analysis of collected samples to identify the pathogen and confirm the disease.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":\"0,48,h\",\"cardinality\":null},{\"type\":\"binary\",\"description\":\"The 'Confirm Disease' activity is permitted to occur only if an 'Analyze Samples' activity has occurred before it within the same process instance. The disease cannot be confirmed without first analyzing samples.\",\"template\":\"Precedence\",\"activation\":{\"name\":\"Confirm Disease\",\"description\":\"The 'Confirm Disease' activity identifies the specific disease type and records the associated mortality rate based on laboratory analysis results.\"},\"target\":{\"name\":\"Analyze Samples\",\"description\":\"The 'Analyze Samples' activity involves laboratory analysis of collected samples to identify the pathogen and confirm the disease.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"A 'Confirm Disease' activity must be followed by an 'Implement Control Measures' activity at some point later in the same process instance. Conversely, an 'Implement Control Measures' event can occur only if a 'Confirm Disease' event has occurred before it. This bidirectional and ordered dependency ensures that confirming the disease imposes an obligation for implementing control measures, and implementing control measures cannot occur without prior disease confirmation.\",\"template\":\"Succession\",\"activation\":{\"name\":\"Confirm Disease\",\"description\":\"The 'Confirm Disease' activity identifies the specific disease type and records the associated mortality rate based on laboratory analysis results.\"},\"target\":{\"name\":\"Implement Control Measures\",\"description\":\"The 'Implement Control Measures' activity specifies and applies public health control measures such as vaccination, quarantine, hygiene campaigns, or social distancing, and records the estimated days to control the outbreak.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If an 'Implement Control Measures' activity occurs, then an 'Inform Public' activity must eventually occur after it at some point in the same process instance.\",\"template\":\"Response\",\"activation\":{\"name\":\"Implement Control Measures\",\"description\":\"The 'Implement Control Measures' activity specifies and applies public health control measures such as vaccination, quarantine, hygiene campaigns, or social distancing, and records the estimated days to control the outbreak.\"},\"target\":{\"name\":\"Inform Public\",\"description\":\"The 'Inform Public' activity communicates information about the outbreak and control measures to the public, tracking the public response.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"An 'Inform Public' activity must be followed by a 'Monitor Disease Spread' activity at some point later in the same process instance. Conversely, a 'Monitor Disease Spread' event can occur only if an 'Inform Public' event has occurred before it. This bidirectional and ordered dependency ensures that informing the public imposes an obligation for monitoring disease spread, and monitoring cannot occur without prior public notification.\",\"template\":\"Succession\",\"activation\":{\"name\":\"Inform Public\",\"description\":\"The 'Inform Public' activity communicates information about the outbreak and control measures to the public, tracking the public response.\"},\"target\":{\"name\":\"Monitor Disease Spread\",\"description\":\"The 'Monitor Disease Spread' activity tracks the progression and spread of the disease over time to assess the effectiveness of control measures.\"},\"activation_condition\":null,\"correlation_condition\":null,\"time_condition\":null,\"cardinality\":null},{\"type\":\"binary\",\"description\":\"If a 'Report Disease Outbreak' activity occurs with the Number of Cases greater than 500, then an 'Implement Control Measures' activity must occur within 0 to 24 hours of the initial report as a critical emergency bypass protocol.\",\"template\":\"Response\",\"activation\":{\"name\":\"Report Disease Outbreak\",\"description\":\"The 'Report Disease Outbreak' activity represents the initial reporting of a disease outbreak, capturing the source of the report and the number of cases detected.\"},\"target\":{\"name\":\"Implement Control Measures\",\"description\":\"The 'Implement Control Measures' activity specifies and applies public health control measures such as vaccination, quarantine, hygiene campaigns, or social distancing, and records the estimated days to control the outbreak.\"},\"activation_condition\":\"A.Number of Cases > 500\",\"correlation_condition\":null,\"time_condition\":\"0,24,h\",\"cardinality\":null}]}"